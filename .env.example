SUPABASE_URL=your_project_url
# Must be the service_role secret key (Project Settings > API), not the anon/public key.
# Required for /auth/logout, which calls supabase.auth.admin.sign_out(token).
# Never expose this key to a frontend or commit it.
SUPABASE_KEY=your_supabase_service_role_key
PORT=8000
